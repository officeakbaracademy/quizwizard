# Copy to .env.local and fill in. Restart "npm run dev" after changing it.

# Question bank API, through the dev proxy (see vite.config.js).
VITE_API_BASE_URL=/api/v1
VITE_API_TARGET=https://<backend-address>

# The normal chat token (the question bank uses the student API). No VITE_ prefix: the proxy adds it, the browser never sees it.
API_TOKEN=<chat token>
